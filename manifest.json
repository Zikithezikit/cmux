{
  "manifest_version": 3,
  "name": "chrome-tmux",
  "version": "0.1.0",
  "description": "tmux inside Chrome: split panes, windows, sessions, status line, copy mode and your ~/.tmux.conf (with TPM plugin emulation).",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open chrome-tmux workspace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["src/shared/keys.js", "src/content/pane-agent.js"]
    }
  ],
  "commands": {
    "open-workspace": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the chrome-tmux workspace"
    }
  }
}
